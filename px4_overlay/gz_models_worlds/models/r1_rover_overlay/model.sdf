      <visual name='aruco_marker_visual'>
        <pose>0 0 0.132 0 0 0</pose>
        <geometry>
          <box>
            <size>0.40 0.40 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>1 1 1 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://r1_rover/materials/textures/aruco_marker.png</albedo_map>
