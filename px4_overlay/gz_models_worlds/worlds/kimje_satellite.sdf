<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="kimje_satellite">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer"/>

    <!-- GPS 원점: 김제 농경지 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>35.765</latitude_deg>
      <longitude_deg>126.895</longitude_deg>
      <elevation>5</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- 조명 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.1 -0.9</direction>
    </light>
    <light name="sun2" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.3 0.35 0.4 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.4 -0.1 -0.9</direction>
    </light>

    <!-- 하늘 -->
    <scene>
      <ambient>0.4 0.45 0.5 1</ambient>
      <background>0.53 0.74 0.95 1</background>
      <sky><clouds><speed>3</speed></clouds></sky>
    </scene>

    <!-- 평탄 지면 (충돌 완벽) -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <pbr>
              <metal>
                <albedo_map>file:///home/user/PX4-Autopilot/Tools/simulation/gz/models/kimje_terrain/textures/satellite.png</albedo_map>
                <normal_map>file:///home/user/PX4-Autopilot/Tools/simulation/gz/models/kimje_terrain/textures/normal.png</normal_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ArUco 착륙 패드 -->
    <model name="aruco_landing_pad">
      <static>true</static>
      <pose>50 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.8 0.01</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 방제 시작점 마커 (빨간 원) -->
    <model name="spray_start">
      <static>true</static>
      <pose>-100 -100 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.0</radius><length>0.1</length></cylinder>
          </geometry>
          <material>
            <ambient>1 0.2 0.2 1</ambient>
            <diffuse>1 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 방제 구역 표시 (녹색 테두리) -->
    <model name="field_marker_1">
      <static>true</static>
      <pose>0 150 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>200 2 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="field_marker_2">
      <static>true</static>
      <pose>0 -150 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>200 2 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="field_marker_3">
      <static>true</static>
      <pose>150 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2 300 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="field_marker_4">
      <static>true</static>
      <pose>-150 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2 300 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
